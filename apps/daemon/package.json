{
  "name": "@crewpip/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "crewpip-daemon": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "snippets": "tsx src/setup.ts",
    "db:status": "tsx src/db-cli.ts status",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "db:backup": "tsx src/db-cli.ts backup",
    "test:board": "pnpm --filter @crewpip/web build && tsx --test test/browser/board-language.ts"
  },
  "dependencies": {
    "@crewpip/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^5.1.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "playwright-core": "1.65.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
